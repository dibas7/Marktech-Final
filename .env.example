# Copy to .env and fill in your Supabase project values (Project Settings → API).
# Required for local dev and for npm run build:host (values are embedded in the production bundle).

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# Optional — used by some tooling; not required by the app runtime.
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
